<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>CollegeTime Summary</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1.0, user-scalable=no" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <link rel="icon" type="image/png" sizes="32x32" href="images/hr-favicon.png">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="~/Content/mobile/css/bootstrap.min.css" />
    <link rel="stylesheet" type="text/css" href="~/Content/mobile/css/mobile-punch.css" />
    @Styles.Render("~/Content/kendo/2016.1.226/bundles")
    <script type="text/javascript" src="~/Scripts/mobile/js/jquery.min.js"></script>
    <script type="text/javascript" src="~/Scripts/mobile/js/bootstrap.min.js"></script>
    @Scripts.Render("~/bundles/kendo")
    <style>
        .ct-summary-panel {
            margin-top: 8px;
            padding: 8px;
            border-radius: 18px;
            background: rgba(255, 255, 255, 0.72);
            border: 1px solid var(--ct-line);
            min-height: 180px;
        }

        .ct-field .k-dropdown,
        .ct-field .k-widget {
            width: 100% !important;
            border-radius: 14px;
            overflow: hidden;
        }
    </style>
</head>
<body class="ct-mobile-body">
    <div class="ct-app">
        <header class="ct-header">
            <button type="button" class="ct-header__btn" title="Back" aria-label="Back"
                    onclick="window.location.href='@Url.Action("Index", "MobileHome")'">
                <i class="fa fa-arrow-left"></i>
            </button>
            <div class="ct-brand">
                <h1 class="ct-brand__name">CollegeTime</h1>
                <span class="ct-brand__tag">Summary</span>
            </div>
            <button type="button" class="ct-header__btn" title="Log out" aria-label="Log out"
                    onclick="window.location.href='@Url.Action("Logout", "Account")'">
                <i class="fa fa-sign-out"></i>
            </button>
        </header>

        <main class="ct-main">
            <div class="ct-fields">
                <div class="ct-field">
                    <label for="ddlPayPeriodId">Pay Period</label>
                    @(Html.Kendo().DropDownList()
                        .Name("ddlPayPeriodId")
                        .DataTextField("PayPeriod").DataValueField("PayPeriodId")
                        .Events(e => e.Change("OnChange"))
                        .BindTo((System.Collections.IEnumerable)ViewData["PayPeriods"])
                        .HtmlAttributes(new { style = "width: 100%" })
                        .Filter(FilterType.Contains)
                    )
                </div>
            </div>
            <div class="ct-summary-panel" id="viewSummeryDiv"></div>
            <div style="margin-top:14px;">
                <a href='@Url.Action("Index", "MobileHome")' class="ct-secondary">Back to Time Clock</a>
            </div>
        </main>

        <footer class="ct-footer">
            © @DateTime.Now.AddYears(-1).Year–@DateTime.Now.Year <a href="#">CollegeTime</a>. All rights reserved.
        </footer>
    </div>

    <script type="text/javascript">
        $(document).ready(function () {
            var dropdownlist = $("#ddlPayPeriodId").data("kendoDropDownList");
            if (dropdownlist) {
                dropdownlist.trigger("change");
            }
        });

        function OnChange() {
            var payPeriod = $("#ddlPayPeriodId").val();
            $.ajax({
                type: "GET",
                url: '@Url.Action("_ViewSummary", "MobileHome")',
                data: { PayPeriodId: payPeriod },
                cache: false,
                success: function (data) {
                    if (data == "") {
                        alert("Your session has been timed out or expired. Click 'OK' to login and continue.");
                        window.location = '@Url.Action("Login","Account")';
                    }
                    if (data != null) {
                        $("#viewSummeryDiv").empty();
                        $("#viewSummeryDiv").html(data);
                    }
                }
            });
        }
    </script>
</body>
</html>
