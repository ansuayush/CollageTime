@model ExecViewHrk.WebUI.Models.AcceptPunchVM
@{
    Layout = null;
    var initials = "";
    if (Model != null && !string.IsNullOrWhiteSpace(Model.FullName))
    {
        var parts = Model.FullName.Trim().Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
        initials = parts.Length == 1
            ? parts[0].Substring(0, 1).ToUpperInvariant()
            : (parts[0].Substring(0, 1) + parts[parts.Length - 1].Substring(0, 1)).ToUpperInvariant();
    }
}
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>CollegeTime</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1.0, user-scalable=no" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <link rel="icon" type="image/png" sizes="32x32" href="images/hr-favicon.png">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="~/Content/mobile/css/bootstrap.min.css" />
    <link rel="stylesheet" type="text/css" href="~/Content/mobile/css/mobile-punch.css" />
</head>
<body class="ct-mobile-body">
    <div class="ct-app">
        <header class="ct-header">
            <button type="button" class="ct-header__btn" title="Home" aria-label="Home"
                    onclick="window.location.href='@Url.Action("Index", "HrkAdmin")'">
                <i class="fa fa-home"></i>
            </button>
            <div class="ct-brand">
                <h1 class="ct-brand__name">CollegeTime</h1>
                <span class="ct-brand__tag">Time Clock</span>
            </div>
            <button type="button" class="ct-header__btn" title="Log out" aria-label="Log out"
                    onclick="window.location.href='@Url.Action("Logout", "Account")'">
                <i class="fa fa-sign-out"></i>
            </button>
        </header>

        <main class="ct-main">
            @if (Model == null)
            {
                <div class="ct-empty">
                    <h2>Account not ready</h2>
                    <p>Person/Student has not been assigned.</p>
                    <p>Contact your admin.</p>
                </div>
            }
            else if (Model.IsInActive)
            {
                <div class="ct-empty">
                    <h2>Inactive account</h2>
                    <p>You are not an active Person/Student.</p>
                    <p>Contact your admin.</p>
                </div>
            }
            else
            {
                <form id="AcceptPunch" action="@Url.Action("AcceptPunch","MobileHome")" name="Accept Employee Punch" method="post">
                    <div class="ct-time">
                        <p class="ct-time__clock" id="ctLiveClock">@Model.CurrentDate.ToString("h:mm tt")</p>
                        <p class="ct-time__date">@Model.CurrentDate.ToString("dddd, MMM dd yyyy")</p>
                    </div>

                    <div class="ct-employee">
                        <div class="ct-avatar" aria-hidden="true">@initials</div>
                        <div class="ct-employee__meta">
                            <span class="ct-employee__label">Employee</span>
                            <span class="ct-employee__name">@Model.FullName</span>
                        </div>
                    </div>

                    <div class="ct-stats">
                        <div class="ct-stat">
                            <span class="ct-stat__label">Daily total</span>
                            <span class="ct-stat__value"><span id="dailytotal">@String.Format("{0:0.00}", Model.DailyTotal)</span></span>
                            <span class="ct-stat__unit">hours</span>
                        </div>
                        <div class="ct-stat">
                            <span class="ct-stat__label">Pay period</span>
                            <span class="ct-stat__value"><span id="payperiodtotal">@String.Format("{0:0.00}", Model.PayPeriodTotal)</span></span>
                            <span class="ct-stat__unit">hours</span>
                        </div>
                    </div>
                    <p class="ct-period">
                        @(Model.PayPeriodStartDate.HasValue ? Model.PayPeriodStartDate.Value.ToShortDateString() : "")
                        –
                        @(Model.PayPeriodEndDate.HasValue ? Model.PayPeriodEndDate.Value.ToShortDateString() : "")
                    </p>

                    <div id="locationMsg" class="ct-alert geo-alert" style="display:none;">
                        <i class="fa fa-exclamation-circle"></i>
                        <span id="geoAlertText"></span>
                    </div>

                    @if (Model.IsPayPeriodLocked)
                    {
                        <div class="ct-notice">Pay period is locked. Please contact your manager/supervisor.</div>
                    }
                    @if (!String.IsNullOrEmpty(Model.NotificationMessage))
                    {
                        <div class="ct-notice">@Model.NotificationMessage</div>
                    }
                    @if (Model.PositionList == null)
                    {
                        <div class="ct-notice">No pay period is active at this moment.</div>
                    }

                    <div class="ct-fields">
                        <div class="ct-field">
                            <label for="ddlCompanyCode">Company</label>
                            @Html.DropDownListFor(m => Model.SelectedCompanyCode, new SelectList(Model.CompanyCodeList, "CompanyCodeId", "CompanyCodeDescription"), new { @id = "ddlCompanyCode", @class = "ct-select" })
                        </div>
                        <div class="ct-field">
                            <label for="ddlGeofenceName">Location</label>
                            @Html.DropDownListFor(m => Model.SelectedGeoName, new SelectList(Model.GeofenceslocationList, "Id", "GeofenceName"), new { @id = "ddlGeofenceName", @class = "ct-select" })
                        </div>
                        @if (Model.PositionList != null)
                        {
                            <div class="ct-field">
                                <label for="ddlPosition">Position</label>
                                @Html.DropDownListFor(m => Model.EpositionId, new SelectList(Model.PositionList, "EpositionId", "PositionDescription"), new { @id = "ddlPosition", @class = "ct-select" })
                            </div>
                        }
                    </div>

                    @if (Model.PositionList != null)
                    {
                        <div class="ct-actions">
                            <div id="punchButtonsView" class="ct-punch-grid"></div>
                            <a href='@Url.Action("Summary", "MobileHome")' class="ct-secondary">View Summary</a>
                        </div>

                        @Html.HiddenFor(m => m.clLatitude, new { @id = "hdnLatitude" })
                        @Html.HiddenFor(m => m.clLongitude, new { @id = "hdnlongitude" })
                        @Html.HiddenFor(m => m.PunchType)
                        @Html.HiddenFor(m => m.EmployeeId, new { @id = "hdnEmployeeId" })
                        @Html.HiddenFor(m => m.CompanyCodeId, new { @id = "hdnCompanyCodeId" })
                        @Html.HiddenFor(m => m.CurrentDate, new { @id = "hdnCurrentDate" })
                        @Html.HiddenFor(m => m.IsPayPeriodLocked)
                        @Html.HiddenFor(m => m.FileName)
                        @Html.HiddenFor(m => m.NightShiftOn)
                        @Html.HiddenFor(m => m.NightShiftTimeCardId)
                        @Html.HiddenFor(m => m.MaxHours)
                        @Html.HiddenFor(m => m.Week1Hours)
                        @Html.HiddenFor(m => m.Week2Hours)
                        @Html.HiddenFor(m => m.PayPeriodStartDate)
                        @Html.HiddenFor(m => m.TreatyTime)
                        @Html.HiddenFor(m => m.SelectedGeoName, new { @id = "hdngeofancyId" })
                    }
                </form>
            }
        </main>

        <footer class="ct-footer">
            © @DateTime.Now.AddYears(-1).Year–@DateTime.Now.Year <a href="#">HR Next</a>. All rights reserved.
        </footer>
    </div>

    <script type="text/javascript" src="~/Scripts/mobile/js/jquery.min.js"></script>
    <script type="text/javascript">
        function SetPunchType(punchType) {
            punchType = Number(punchType);
            if ((punchType === 0) && ($("#hidNightShiftOn").val() === "1")) {
                if (window.confirm("Would you like to 'Clock Out' for the night shift?")) {
                    $("#NightShiftOn").val($("#hidNightShiftOn").val());
                    $("#NightShiftTimeCardId").val($("#hidNightShiftTimeCardId").val());
                    $("#PunchType").val(3);
                }
                else {
                    $("#PunchType").val(punchType);
                }
            }
            else {
                $("#PunchType").val(punchType);
            }
            if (punchType !== 1 && punchType !== 2) {
                var MaxHours = $('#MaxHours').val();
                var TreatyTime = $('#TreatyTime').val();
                var week1 = $('#Week1Hours').val();
                var week2 = $('#Week2Hours').val();
                var week1Limit = (MaxHours - week1).toFixed(2);
                var week2Limit = (MaxHours - week2).toFixed(2);
                var dt = new Date($('#PayPeriodStartDate').val());
                var weekEndDate = new Date(dt.getTime() + 6 * 24 * 60 * 60 * 1000);
                var date = new Date();
                date.setHours(0, 0, 0, 0);
                if (date > weekEndDate) {
                    if (Number(week2) >= Number(TreatyTime)) {
                        alert(week2Limit + " hours remaining before reaching session limit.");
                    }
                }
                else {
                    if (Number(week1) >= Number(TreatyTime)) {
                        alert(week1Limit + " hours remaining before reaching session limit.");
                    }
                }
            }
            return true;
        }

        function loadPunchButtons() {
            $("#ddlPosition").trigger("change");
        }

        $("#ddlPosition").on("change", function () {
            var positionidnew = $("#ddlPosition").val();
            if (!positionidnew) { return; }
            var positionId = positionidnew.split('-')[1];
            var employeeId = $("#hdnEmployeeId").val();
            var companyCodeId = $("#hdnCompanyCodeId").val();
            var geofancyId = $("#hdngeofancyId").val();
            var punchTime = new Date().toISOString().slice(0, 19);
            if ($("#IsPayPeriodLocked").val().toLowerCase() !== "true") {
                $.ajax({
                    type: "GET",
                    url: '@Url.Action("_PunchButtons", "MobileHome")',
                    data: { employeeId: employeeId, positionId: positionId, punchTime: punchTime, companyCodeId: companyCodeId, geofancyId: geofancyId },
                    cache: false,
                    success: function (data) {
                        if (data === "") {
                            alert("Your session has been timed out or expired. Click 'OK' to login and continue.");
                            window.location = '@Url.Action("Login","Account")';
                        }
                        if (data !== null) {
                            $("#punchButtonsView").empty();
                            $("#punchButtonsView").html(data);
                        }
                    },
                    error: function (xhr, status, error) {
                        console.log("AJAX ERROR:", xhr.responseText, status, error);
                        alert("Ajax error: " + error);
                    }
                });
            }
        });

        $(document).ready(function () {
            triggerRefresh();
            GetLocation();
            tickClock();
            setInterval(tickClock, 30000);
        });

        function tickClock() {
            var now = new Date();
            var hours = now.getHours();
            var minutes = now.getMinutes();
            var ampm = hours >= 12 ? "PM" : "AM";
            hours = hours % 12;
            hours = hours ? hours : 12;
            minutes = minutes < 10 ? "0" + minutes : minutes;
            $("#ctLiveClock").text(hours + ":" + minutes + " " + ampm);
        }

        function triggerRefresh() {
            if ($('#ddlPosition > option').length > 0)
                $("#ddlPosition").trigger("change");
        }

        function GetLocation() {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(ShowPosition);
            } else {
                alert('Geolocation is not supported by this browser.');
            }
        }

        function ShowPosition(position) {
            $("#hdnLatitude").val(position.coords.latitude);
            $("#hdnlongitude").val(position.coords.longitude);
        }

        $("#ddlGeofenceName").on("change", function () {
            var geofenceNameId = $("#ddlGeofenceName").val();
            var clsLatitude = $("#hdnLatitude").val();
            var clslongitude = $("#hdnlongitude").val();
            $("#hdngeofancyId").val(geofenceNameId);

            $.ajax({
                url: '/MobileHome/ValidateLocationRange',
                type: 'GET',
                data: { geofenceId: geofenceNameId, latitude: clsLatitude, longitude: clslongitude },
                success: function (res) {
                    if (res.isValid === false) {
                        showGeoError('Selected location is outside the allowed range.');
                    }
                    else {
                        hideGeoError();
                    }
                }
            });
        });

        function showGeoError(message) {
            $('#geoAlertText').text(message);
            $('#locationMsg').addClass('is-visible').fadeIn();
            loadPunchButtons();
        }

        function hideGeoError() {
            loadPunchButtons();
            $('#locationMsg').removeClass('is-visible').fadeOut();
        }

        $("#ddlCompanyCode").on("change", function () {
            var companyCodeId = $("#ddlCompanyCode").val();
            $("#punchButtonsView").html("");
            $("#hdnCompanyCodeId").val(companyCodeId);
            $.ajax({
                type: "GET",
                url: '@Url.Action("CompanyCodeOnChange", "MobileHome")',
                data: { companyCodeId: companyCodeId },
                cache: false,
                success: function (data) {
                    $("#ddlPosition").empty();
                    $.each(data.posList, function (d, value) {
                        $("#ddlPosition").append($("<option></option>").val(value.EpositionId).html(value.PositionDescription));
                    });
                    $("#payperiodtotal").html(data.payPeriodTotal);
                    triggerRefresh();
                },
                error: function () { }
            });
        });
    </script>
</body>
</html>
