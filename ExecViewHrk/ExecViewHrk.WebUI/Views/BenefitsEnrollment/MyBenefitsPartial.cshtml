@model ExecViewHrk.WebUI.Models.BenPortalVm
@{
    Layout = null;
    var m = Model ?? new ExecViewHrk.WebUI.Models.BenPortalVm();
}
<div class="container-fluid portal-page" id="benPortalRoot"
     data-portal-url="@Url.Action("GetPortalData", "BenefitsEnrollment")"
     data-start-url="@Url.Action("StartEnrollment", "BenefitsEnrollment")"
     data-save-elect-url="@Url.Action("SaveElections", "BenefitsEnrollment")"
     data-save-dep-url="@Url.Action("SaveDependents", "BenefitsEnrollment")"
     data-save-ben-url="@Url.Action("SaveBeneficiaries", "BenefitsEnrollment")"
     data-submit-url="@Url.Action("SubmitEnrollment", "BenefitsEnrollment")"
     data-eligible="@(m.IsEligible ? "1" : "0")"
     data-enrollment-id="@(m.EnrollmentId ?? 0)"
     data-status="@(m.EnrollmentStatus ?? "")">
    <div class="main-header portal-page-heading p-0">
        <div class="portal-page-heading__title"><h4>Open Enrollment</h4></div>
    </div>

    @if (!m.IsEligible)
    {
        <div class="alert alert-warning">@(m.Message ?? "You are currently not eligible.")</div>
    }
    else
    {
        <div class="alert alert-info">
            <strong>@(m.ActivePeriod != null ? m.ActivePeriod.EnrollmentName : "Open Enrollment")</strong>
            @if (m.Deadline.HasValue)
            {
                <span> | Deadline: @m.Deadline.Value.ToString("MM/dd/yyyy")</span>
            }
            @if (m.BenefitClass != null)
            {
                <span> | Benefit Class: @m.BenefitClass.ClassName</span>
            }
            @if (!string.IsNullOrEmpty(m.EnrollmentStatus))
            {
                <span> | Status: <strong>@m.EnrollmentStatus</strong></span>
            }
        </div>
        if (!string.IsNullOrEmpty(m.Message))
        {
            <p>@m.Message</p>
        }
        if (!string.IsNullOrEmpty(m.ConfirmationNumber))
        {
            <div class="alert alert-success">Confirmation: <strong>@m.ConfirmationNumber</strong></div>
        }

        <div id="benPlansPanel">
            <h5>Available Plans</h5>
            <div id="benPlansList"></div>
        </div>

        <div id="benDepsPanel" style="display:none;" class="m-t-15">
            <h5>Dependents</h5>
            <div id="benDepsList"></div>
            <button type="button" class="btn btn-sm btn-default" id="btnAddDep">Add Dependent</button>
        </div>

        <div id="benBenePanel" style="display:none;" class="m-t-15">
            <h5>Beneficiaries (must total 100%)</h5>
            <div id="benBeneList"></div>
            <button type="button" class="btn btn-sm btn-default" id="btnAddBene">Add Beneficiary</button>
        </div>

        <div id="benCostPanel" class="m-t-15">
            <h5>Cost Summary</h5>
            <div id="benCostSummary"></div>
        </div>

        <div id="benSignPanel" class="m-t-15 card">
            <div class="card-block">
                <h5>Electronic Signature</h5>
                <div class="checkbox"><label><input type="checkbox" id="benTerms" /> I agree to the benefit terms.</label></div>
                <div class="form-group"><label>Type your full name</label><input class="form-control" id="benSignedName" maxlength="150" /></div>
                <button type="button" class="btn btn-success" id="btnSubmitBen" @(m.EnrollmentStatus == "Submitted" || m.EnrollmentStatus == "Approved" ? "disabled=\"disabled\"" : "")>Submit Enrollment</button>
                <button type="button" class="btn btn-primary" id="btnStartBen">@(m.EnrollmentId.HasValue ? "Continue / Save Elections" : "Enroll Now")</button>
            </div>
        </div>
    }
</div>
<script src="~/Scripts/application/BenefitsEnrollmentPortal.js?v=20260807a"></script>
