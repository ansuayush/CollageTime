@{

    Layout = null;

}

<link rel="stylesheet" href="~/Content/performance-review.css?v=20260902h" />

<div class="container-fluid" id="prMyRoot"

     data-list-url="@Url.Action("GetMyTasks", "PerformanceReview")"

     data-task-url="@Url.Action("GetTask", "PerformanceReview")"

     data-save-url="@Url.Action("SaveTask", "PerformanceReview")"

     data-reject-url="@Url.Action("RejectTask", "PerformanceReview")">

    <div class="main-header p-0">

        <h4>My Performance Reviews</h4>

        <p class="text-muted">Tasks assigned to you as Approver / reviewer. Save draft anytime; Submit sends to the next step.</p>

    </div>

    <table class="table table-bordered table-striped" id="prMyTable">

        <thead><tr><th>Review</th><th>Employee</th><th>Your Role</th><th>Due</th><th>Status</th><th></th></tr></thead>

        <tbody></tbody>

    </table>

</div>

<div class="modal fade pr-review-modal" id="prMyModal" tabindex="-1">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-body p-0" id="prMyModalBody"></div>

        </div>

    </div>

</div>

<script src="~/Scripts/application/PerformanceReviewForm.js?v=20260902h"></script>

<script src="~/Scripts/application/PerformanceReviewPortal.js?v=20260902h"></script>

