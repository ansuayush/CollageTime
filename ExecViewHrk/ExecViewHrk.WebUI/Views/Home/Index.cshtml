@{
    ViewBag.Title = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="portal-hero container-fluid p-b-0">
    <div class="row">
        <div class="col-md-12 p-0">
            <div class="portal-hero__media">
                <img src="~/assets/images/hr-time-hero.jpg" alt="HR and Time" />
                <div class="portal-hero__veil"></div>
            </div>
        </div>
        <div class="col-md-12 p-0">
            <div class="portal-welcome">
                <p class="portal-welcome__brand">HRNest</p>
                <h1 class="portal-welcome__title">A clearer place to start</h1>
                <p class="portal-welcome__lead">Choose a product from the menu above to continue.</p>
            </div>
        </div>
    </div>
</div>
