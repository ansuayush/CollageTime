@model ExecViewHrk.WebUI.Models.ApplyRegisterVm
@{
    Layout = "~/Views/Shared/_ApplyLayout.cshtml";
    ViewBag.Title = "Create Account";
}
<div class="apply-card">
    <h4>Create applicant account</h4>
    <p class="text-muted">Create a username and password so you can apply now and return later for other jobs.</p>
    @using (Html.BeginForm("Register", "Apply", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.EmployerId)
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="row">
            <div class="col-md-6 form-group">
                <label>Username</label>
                @Html.TextBoxFor(m => m.UserName, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.UserName)
            </div>
            <div class="col-md-6 form-group">
                <label>Email</label>
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 form-group">
                <label>First name</label>
                @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control" })
            </div>
            <div class="col-md-6 form-group">
                <label>Last name</label>
                @Html.TextBoxFor(m => m.LastName, new { @class = "form-control" })
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 form-group">
                <label>Phone</label>
                @Html.TextBoxFor(m => m.Phone, new { @class = "form-control" })
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 form-group">
                <label>Password</label>
                @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
            </div>
            <div class="col-md-6 form-group">
                <label>Confirm password</label>
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control" })
            </div>
        </div>
        <button type="submit" class="btn btn-primary">Create account</button>
        <a class="btn btn-link" href="@Url.Action("Login", new { employerId = Model.EmployerId })">Already have an account?</a>
    }
</div>
