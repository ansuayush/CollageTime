@model ExecViewHrk.WebUI.Models.RecruitingConfigVm
@{
    Layout = null;
}
<div class="container-fluid" id="recruitingConfigRoot"
     data-save-url="@Url.Action("SaveConfig", "RecruitingSetup")">
    <div class="main-header p-0"><h4>Recruiting Configuration</h4></div>
    <div class="alert alert-info">
        External apply wizard link (share with candidates):
        <div class="m-t-5">
            <input type="text" class="form-control" readonly value="@Model.ExternalApplyUrl" onclick="this.select();" />
        </div>
        <small>Employer Id: @Model.EmployerId (must be set for the link to resolve the client database).</small>
    </div>
    <div class="card">
        <div class="card-block">
            <div class="form-group">
                <label>Home page content</label>
                <textarea id="cfgHome" class="form-control" rows="4">@Model.HomePageHtml</textarea>
            </div>
            <div class="form-group">
                <label>Introduction page content</label>
                <textarea id="cfgIntro" class="form-control" rows="4">@Model.IntroductionHtml</textarea>
            </div>
            <div class="form-group">
                <label>Review &amp; submit page content</label>
                <textarea id="cfgReview" class="form-control" rows="4">@Model.ReviewSubmitHtml</textarea>
            </div>
            <div class="form-group">
                <label>Attestation content (default used if blank)</label>
                <textarea id="cfgAttest" class="form-control" rows="4">@Model.AttestationHtml</textarea>
            </div>
            <button type="button" class="btn btn-primary" id="btnSaveCfg">Save Configuration</button>
            <button type="button" class="btn btn-default" onclick='LoadMenu("RequisitionDashboardPartial", "Requisition")'>Back to Dashboard</button>
        </div>
    </div>
</div>
<script>
(function () {
    $("#btnSaveCfg").click(function () {
        $.ajax({
            url: $("#recruitingConfigRoot").data("save-url"),
            type: "POST",
            data: {
                HomePageHtml: $("#cfgHome").val(),
                IntroductionHtml: $("#cfgIntro").val(),
                ReviewSubmitHtml: $("#cfgReview").val(),
                AttestationHtml: $("#cfgAttest").val()
            },
            success: function (res) {
                if (!res.success) alert(res.message || "Save failed");
                else alert("Saved.");
            }
        });
    });
})();
</script>
