@{
    Layout = null;
    bool isSelfService = ViewBag.IsSelfService == true;
}
<link rel="stylesheet" href="~/Content/training-module.css?v=20260910a" />

<div class="container-fluid" id="trEnrollRoot"
     data-self="@(isSelfService ? "1" : "0")"
     data-lookups-url="@Url.Action("GetLookups", "TrainingEnrollment")"
     data-schedules-url="@Url.Action("GetSchedulesForClass", "TrainingEnrollment")"
     data-defaults-url="@Url.Action("GetClassDefaults", "TrainingEnrollment")"
     data-search-url="@Url.Action("SearchEmployees", "TrainingEnrollment")"
     data-list-url="@Url.Action("GetEnrollments", "TrainingEnrollment")"
     data-get-url="@Url.Action("GetEnrollment", "TrainingEnrollment")"
     data-save-url="@Url.Action("SaveEnrollment", "TrainingEnrollment")"
     data-del-url="@Url.Action("DeleteEnrollments", "TrainingEnrollment")">

    <div class="main-header p-0 clearfix">
        <h4 style="display:inline-block;">@(isSelfService ? "My Training" : "Training Assignments")</h4>
        @if (!isSelfService)
        {
            <div class="pull-right">
                <button type="button" class="btn btn-default btn-sm" onclick='LoadMenu("SetupPartial", "TrainingAdmin")'>Training Administration</button>
            </div>
        }
        <p class="text-muted">
            @(isSelfService
                ? "View and enroll in training classes assigned to you."
                : "Assign employees to training classes. Schedule, dates, track and course details populate from the selected class.")
        </p>
    </div>

    @if (ViewBag.SchemaError != null)
    {
        <div class="alert alert-danger">Training setup error: @ViewBag.SchemaError</div>
    }

    <div class="m-b-10">
        <button type="button" class="btn btn-sm btn-primary" id="btnTrAdd">Add</button>
        @if (!isSelfService)
        {
            <button type="button" class="btn btn-sm btn-danger" id="btnTrDel">Delete</button>
        }
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-striped" id="trEnrollTable">
            <thead>
                <tr>
                    @if (!isSelfService) { <th><input type="checkbox" id="trEnrollCheckAll" /></th> }
                    <th>Employee</th>
                    <th>Class Name</th>
                    <th>Course Code</th>
                    <th>Status</th>
                    <th>Enrolled</th>
                    <th>Completed</th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Expiration</th>
                    <th></th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="trEnrollModal" tabindex="-1"><div class="modal-dialog modal-lg"><div class="modal-content">
    <div class="modal-header"><button type="button" class="close" data-dismiss="modal">&times;</button><h5 class="modal-title">Training Enrollment</h5></div>
    <div class="modal-body" id="trEnrollModalBody"></div>
    <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="trEnrollSave">Add</button>
    </div>
</div></div></div>

<script src="~/Scripts/application/TrainingEnrollment.js?v=20260910c"></script>
