@model ExecViewHrk.WebUI.Models.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Login : HRNest</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1.0, user-scalable=no" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <link rel="icon" href="~/assets/images/hr-knowledge.png" type="image/x-icon">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap" rel="stylesheet" />
    <link href="https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="~/assets/css/bootstrap.min.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/css/main.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/css/custom.css" />
    <link href="~/assets/css/login-css.css" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="~/assets/css/portal-theme.css" />
</head>
<body class="portal-login">
    <div class="wrapper portal-login__shell">
        <div id="center-wrapper">
            <div id="overlay">
                <div id="mainLoginWrapper">
                    <div>
                        @Html.ValidationSummary(true, null, new { @class = "f-13 portal-login__error" })

                        @if (TempData["message"] != null)
                        {
                            <div class="alert alert-success">@TempData["message"]</div>
                        }
                        <div class="welcomeBlock m-b-10">
                            <p class="portal-login__brand">HRNest</p>
                            <h2 id="portal.login.welcome" class="portal-login__title">Sign in to continue</h2>
                        </div>
                    </div>
                    <div class="login-main">
                        <div class="portal-login__form">
                            @using (Html.BeginForm())
                            {
                                @Html.HiddenFor(x => x.Browser_Time, new { @Value = Convert.ToDateTime("12/12/2017") })
                                <input type="hidden" name="returnUrl" value="@ViewBag.returnUrl" />
                                <div>
                                    <input type="hidden" name="target" value="/portal/theme">
                                    <label class="loginLabel" id="login">User ID</label>
                                    @Html.TextBoxFor(x => x.Name, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(x => x.Name, null, new { @class = "f-12 portal-login__error" })
                                    <label class="loginLabel m-t-10" id="login-pw">Password</label>
                                    @Html.PasswordFor(x => x.Password, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(x => x.Password, null, new { @class = "f-12 portal-login__error" })
                                </div>
                                <div class="portal-login__forgot">
                                    <a href="@Url.Action("ForgotPassword", "Account")" class="forgotUID">Forgot Your User ID/Password?</a>
                                </div>
                                <div class="portal-login__actions">
                                    <button type="submit" class="btn portal-login__submit">
                                        Log In
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
