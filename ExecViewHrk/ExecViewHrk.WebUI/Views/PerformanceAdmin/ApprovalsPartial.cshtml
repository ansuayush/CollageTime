@{

    Layout = null;

}

<link rel="stylesheet" href="~/Content/performance-review.css?v=20260902h" />

<div class="container-fluid" id="prHrRoot"

     data-queue-url="@Url.Action("GetHrQueue", "PerformanceAdmin")"

     data-task-url="@Url.Action("GetTask", "PerformanceReview")"

     data-save-url="@Url.Action("SaveTask", "PerformanceReview")"

     data-reject-url="@Url.Action("RejectTask", "PerformanceReview")">

    <div class="main-header p-0 clearfix">

        <h4 style="display:inline-block;">HR Final Approvals</h4>

        <button type="button" class="btn btn-default btn-sm pull-right" onclick='LoadMenu("SetupPartial", "PerformanceAdmin")'>Back to Setup</button>

    </div>

    <table class="table table-bordered table-striped" id="prHrTable">

        <thead><tr><th>Review</th><th>Employee</th><th>Due</th><th>Status</th><th></th></tr></thead>

        <tbody></tbody>

    </table>

</div>

<div class="modal fade pr-review-modal" id="prHrModal" tabindex="-1">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-body p-0" id="prHrModalBody"></div>

        </div>

    </div>

</div>

<script src="~/Scripts/application/PerformanceReviewForm.js?v=20260902h"></script>

<script src="~/Scripts/application/PerformanceAdminApprovals.js?v=20260902h"></script>

