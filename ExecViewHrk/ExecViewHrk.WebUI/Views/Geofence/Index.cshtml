@model List<ExecViewHrk.WebUI.Models.GeofenceVM>
@{
    ViewBag.Title = "Geofence";
    Layout = null;
}
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.2/css/dataTables.bootstrap5.min.css" />
<style type="text/css">
    #dvMap {
        height: 500px;
        width: 100%;
    }

    #infowindow-content .title {
        font-weight: bold;
    }

    #infowindow-content {
        display: none;
    }

    #dvMap #infowindow-content {
        display: inline;
    }

    .pac-card {
        background-color: #fff;
        border: 0;
        border-radius: 2px;
        box-shadow: 0 1px 4px -1px rgba(0, 0, 0, 0.3);
        margin: 10px;
        font: 400 18px Roboto, Arial, sans-serif;
        overflow: hidden;
        padding: 0;
    }

    #pac-container {
        padding-bottom: 12px;
        margin-right: 12px;
        padding-top: 14px;
    }

    #pac-input {
        background-color: #fff;
        font-family: Roboto, Arial, sans-serif;
        font-size: 15px;
        font-weight: 300;
        margin-left: 12px;
        padding: 0 11px 0 13px;
        text-overflow: ellipsis;
        width: 400px;
        height: 30px;
    }

        #pac-input:focus {
            border-color: #4d90fe;
        }

    #title {
        color: #fff;
        background-color: #4d90fe;
        font-size: 25px;
        font-weight: 500;
        padding: 6px 12px;
    }

    .popup-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5);
        z-index: 9999;
    }

    .popup-box {
        background: #fff;
        width: 500px;
        margin: 100px auto;
        padding: 20px;
        border-radius: 5px;
    }

    .close-btn {
        float: right;
        cursor: pointer;
        font-size: 20px;
    }

    .pac-container {
        z-index: 10000 !important;
    }
</style>

<div class="container-fluid">
    <div class="row p-t-15">
        <div class="col-lg-12 col-md-12">
            <div class="main-header col-sm-12 p-0 m-b-0">
                <div class="col-md-9 m-b-15 p-0">
                    <h4>Geofence <span class="pull-right icon-edit-block m-l-30"> <i class="fa fa-expand f-24" onclick="javascript:toggleFullScreen()"></i></span></h4>
                </div>
            </div>
            <div class="col-lg-12 col-md-12 p-0">
                <div class="pac-card" id="pac-card">
                    <div>
                        <div id="title">Geo Fence</div>
                    </div>
                    <div id="pac-container">
                        <input id="pac-input" type="text" placeholder="Enter a location" autocomplete="off" />
                    </div>
                </div>
                <div id="dvMap"></div>
                <div id="popupModal" class="popup-overlay" style="display:none;">
                    <div class="popup-box">
                        <span class="close-btn" onclick="closePopup()">×</span>
                        <div id="popupContent"></div>
                    </div>
                </div>
                <div id="infowindow-content">
                    <span id="place-name" class="title"></span>
                    <br />
                    <span id="place-address"></span>
                </div>
                <div style="height: 20px"></div>
                <div id="LocationList">
                    <table id="Geofence" class="table table-striped display" width="100%">
                        <thead>
                            <tr>
                                <th>Geofence Name</th>
                                <th>Coordinate</th>
                                <th>Radius(Ft)</th>
                                <th></th>
                                <th></th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    var geofenceMap = null;
    var geofenceMarker = null;
    var geofenceCircle = null;
    var DEFAULT_GEOFENCE_RADIUS_FT = 1000;
    var geofenceMapsApiKey = "AIzaSyDzJLujdxN768-ax6KWJL_xeFpYM8eJ4nk";

    function openPopup(id) {
        $.ajax({
            url: '@Url.Action("_NewGeofenceCoordinate", "Geofence")',
            type: 'GET',
            data: { coordinates: id },
            success: function (result) {
                $('#popupContent').html(result);
                $('#popupModal').show();
            },
            error: function () {
                alert("Unable to open save form.");
            }
        });
    }

    function closePopup() {
        $('#popupModal').hide();
    }

    function drawRedGeofenceCircle(map, location, radiusFt) {
        if (!map || !location) {
            return null;
        }
        if (geofenceCircle) {
            geofenceCircle.setMap(null);
            geofenceCircle = null;
        }
        var feet = parseFloat(radiusFt);
        if (!feet || feet <= 0) {
            feet = DEFAULT_GEOFENCE_RADIUS_FT;
        }
        geofenceCircle = new google.maps.Circle({
            strokeColor: "#FF0000",
            strokeOpacity: 1,
            strokeWeight: 3,
            fillColor: "#FF0000",
            fillOpacity: 0.35,
            map: map,
            center: location,
            radius: feet * 0.3048,
            editable: true,
            draggable: false,
            zIndex: 10
        });
        map.fitBounds(geofenceCircle.getBounds());
        return geofenceCircle;
    }

    function markSelectedPlace(map, place) {
        var location = place.geometry.location;
        var lat = location.lat();
        var lng = location.lng();
        var placeAddress = place.formatted_address || "";
        var placeName = place.name || "";

        map.setCenter(location);
        map.setZoom(15);

        if (!geofenceMarker) {
            geofenceMarker = new google.maps.Marker({
                map: map,
                draggable: true,
                icon: "http://maps.google.com/mapfiles/ms/icons/red-dot.png"
            });
        }
        geofenceMarker.setPosition(location);
        geofenceMarker.setVisible(true);

        drawRedGeofenceCircle(map, location, DEFAULT_GEOFENCE_RADIUS_FT);
        openPopup(lat + "~" + lng + "~" + placeAddress + "~" + placeName);
    }

    function initMap() {
        var mapEl = document.getElementById("dvMap");
        var input = document.getElementById("pac-input");
        var card = document.getElementById("pac-card");
        if (!mapEl || !input) {
            return;
        }
        if (!window.google || !google.maps || !google.maps.places) {
            return;
        }
        if (mapEl.getAttribute("data-geofence-ready") === "1" && geofenceMap) {
            return;
        }

        geofenceMap = null;
        geofenceMarker = null;
        geofenceCircle = null;

        var map = new google.maps.Map(mapEl, {
            center: { lat: 40.749933, lng: -73.98633 },
            zoom: 13,
            mapTypeControl: false
        });
        geofenceMap = map;
        mapEl.setAttribute("data-geofence-ready", "1");

        if (card) {
            map.controls[google.maps.ControlPosition.TOP_LEFT].push(card);
        }

        var autocomplete = new google.maps.places.Autocomplete(input, {
            fields: ["formatted_address", "geometry", "name"],
            strictBounds: false
        });

        google.maps.event.addListener(autocomplete, "place_changed", function () {
            var place = autocomplete.getPlace();
            if (!place || !place.geometry || !place.geometry.location) {
                alert("Please select a location from the dropdown list.");
                return;
            }
            markSelectedPlace(map, place);

            var infowindowContent = document.getElementById("infowindow-content");
            if (infowindowContent && geofenceMarker) {
                var infowindow = new google.maps.InfoWindow({ content: infowindowContent });
                if (infowindowContent.children["place-name"]) {
                    infowindowContent.children["place-name"].textContent = place.name || "";
                }
                if (infowindowContent.children["place-address"]) {
                    infowindowContent.children["place-address"].textContent = place.formatted_address || "";
                }
                infowindow.open(map, geofenceMarker);
            }
        });

        try {
            if (google.maps.drawing && google.maps.drawing.DrawingManager) {
                var selectedShape = null;
                var drawingManager = new google.maps.drawing.DrawingManager({
                    drawingMode: null,
                    drawingControl: true,
                    drawingControlOptions: {
                        position: google.maps.ControlPosition.TOP_CENTER,
                        drawingModes: [google.maps.drawing.OverlayType.CIRCLE]
                    },
                    circleOptions: {
                        fillColor: "#FF0000",
                        fillOpacity: 0.35,
                        strokeColor: "#FF0000",
                        strokeWeight: 3,
                        editable: true,
                        zIndex: 1
                    }
                });

                google.maps.event.addListener(drawingManager, "overlaycomplete", function (event) {
                    drawingManager.setDrawingMode(null);
                    if (event.type === google.maps.drawing.OverlayType.CIRCLE) {
                        if (geofenceCircle && geofenceCircle !== event.overlay) {
                            geofenceCircle.setMap(null);
                        }
                        geofenceCircle = event.overlay;
                        selectedShape = event.overlay;
                        var center = event.overlay.getCenter();
                        var radiusFt = Math.round(event.overlay.getRadius() / 0.3048);
                        openPopup(center.lat() + "~" + center.lng() + "~~Drawn Circle");
                        $("#popupModal").one("DOMNodeInserted", function () {
                            $("#geofenceRadius").val(radiusFt);
                        });
                        setTimeout(function () {
                            if ($("#geofenceRadius").length) {
                                $("#geofenceRadius").val(radiusFt);
                            }
                        }, 500);
                    }
                });

                drawingManager.setMap(map);
            }
        } catch (ex) {
            if (window.console && console.warn) {
                console.warn("Geofence drawing tools unavailable", ex);
            }
        }
    }

    window.initMap = initMap;
    window.BindGrid = BindGrid;
    window.ViewRecord = ViewRecord;
    window.closePopup = closePopup;
    window.openPopup = openPopup;

    function loadGoogleMapsForGeofence() {
        if (window.google && google.maps && google.maps.Map && google.maps.places) {
            initMap();
            return;
        }

        var existing = document.getElementById("geofence-google-maps-script");
        if (existing) {
            var tries = 0;
            var timer = setInterval(function () {
                tries++;
                if (window.google && google.maps && google.maps.places) {
                    clearInterval(timer);
                    initMap();
                } else if (tries > 50) {
                    clearInterval(timer);
                    alert("Google Maps failed to load. Check API key / network.");
                }
            }, 200);
            return;
        }

        var script = document.createElement("script");
        script.id = "geofence-google-maps-script";
        script.src = "https://maps.googleapis.com/maps/api/js?key=" + geofenceMapsApiKey + "&libraries=places,drawing&callback=initMap";
        script.async = true;
        script.onerror = function () {
            alert("Google Maps script failed to load.");
        };
        document.head.appendChild(script);
    }

    function ensureDataTables(callback) {
        if ($.fn.DataTable) {
            callback();
            return;
        }
        if (document.getElementById("geofence-datatables-script")) {
            var tries = 0;
            var timer = setInterval(function () {
                tries++;
                if ($.fn.DataTable) {
                    clearInterval(timer);
                    callback();
                } else if (tries > 40) {
                    clearInterval(timer);
                }
            }, 100);
            return;
        }
        var script = document.createElement("script");
        script.id = "geofence-datatables-script";
        script.src = "https://cdn.datatables.net/1.13.2/js/jquery.dataTables.min.js";
        script.onload = function () { callback(); };
        script.onerror = function () {
            alert("DataTables failed to load.");
        };
        document.head.appendChild(script);
    }

    function BindGrid() {
        ensureDataTables(function () {
            $.ajax({
                type: "GET",
                url: '@Url.Action("GetDesignatedSupervisors", "Geofence")',
                dataType: "json",
                cache: false,
                success: function (result) {
                    var rows = result || [];
                    if ($.fn.DataTable.isDataTable("#Geofence")) {
                        $("#Geofence").DataTable().clear().destroy();
                    }
                    $("#Geofence").DataTable({
                        stateSave: false,
                        destroy: true,
                        data: rows,
                        lengthChange: false,
                        pageLength: 5,
                        info: true,
                        pagingType: "numbers",
                        order: [],
                        columns: [
                            {
                                data: "GeofenceName",
                                defaultContent: "",
                                render: function (data, type, row) {
                                    if (type === "display") {
                                        return '<a class="Bule-b13-link" style="cursor:pointer" onclick="ViewRecord(' +
                                            parseFloat(row.latitude) + ',' + parseFloat(row.longitude) + ',' +
                                            (parseFloat(row.Radius) || 0) + ')">' + (data || "") + "</a>";
                                    }
                                    return data;
                                }
                            },
                            {
                                data: "Coordinate",
                                defaultContent: "",
                                render: function (data, type, row) {
                                    if (data) {
                                        return data;
                                    }
                                    if (row.latitude && row.longitude) {
                                        return row.latitude + "," + row.longitude;
                                    }
                                    return "";
                                }
                            },
                            { data: "Radius", defaultContent: "" },
                            {
                                data: null,
                                orderable: false,
                                defaultContent: "",
                                render: function (data, type, row) {
                                    if (type === "display") {
                                        return '<a class="buttonImage view" style="width:26px;cursor:pointer;" onclick="ViewRecord(' +
                                            parseFloat(row.latitude) + ',' + parseFloat(row.longitude) + ',' +
                                            (parseFloat(row.Radius) || 0) + ')"></a>';
                                    }
                                    return "";
                                }
                            },
                            {
                                data: null,
                                orderable: false,
                                defaultContent: ""
                            }
                        ]
                    });
                },
                error: function (xhr) {
                    if (window.console && console.error) {
                        console.error("Geofence grid load failed", xhr);
                    }
                    alert("Unable to load geofence list.");
                }
            });
        });
    }

    function ViewRecord(latitude, longitude, Radius) {
        if (!latitude || !longitude || !geofenceMap) {
            return;
        }
        var location = { lat: parseFloat(latitude), lng: parseFloat(longitude) };
        geofenceMap.setCenter(location);
        geofenceMap.setZoom(15);
        if (!geofenceMarker) {
            geofenceMarker = new google.maps.Marker({
                map: geofenceMap,
                icon: 'http://maps.google.com/mapfiles/ms/icons/red-dot.png'
            });
        }
        geofenceMarker.setPosition(location);
        geofenceMarker.setVisible(true);
        drawRedGeofenceCircle(geofenceMap, location, Radius || DEFAULT_GEOFENCE_RADIUS_FT);
    }

    function PageRefresh() {
        if (typeof LoadContents === "function") {
            LoadContents("Index", "Geofence");
        } else {
            window.location.reload(true);
        }
    }

    (function startGeofencePage() {
        function boot() {
            BindGrid();
            loadGoogleMapsForGeofence();
        }
        if (window.jQuery) {
            $(boot);
        } else {
            setTimeout(boot, 100);
        }
    })();
</script>
