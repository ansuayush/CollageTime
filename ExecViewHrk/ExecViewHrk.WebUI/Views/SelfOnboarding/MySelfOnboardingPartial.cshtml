<div class="modal fade" id="soRejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h5 class="modal-title">Reject for Corrections</h5>
            </div>
            <div class="modal-body">
                <p>Select the form(s) that need correction and enter a reason. The employee will receive a login email to update and resubmit.</p>
                <div class="form-group">
                    <label>Forms to correct</label>
                    <div class="checkbox"><label><input type="checkbox" class="so-reject-form" value="Personal" /> Personal</label></div>
                    <div class="checkbox"><label><input type="checkbox" class="so-reject-form" value="I-9" /> I-9</label></div>
                    <div class="checkbox"><label><input type="checkbox" class="so-reject-form" value="Documents" /> Documents</label></div>
                    <div class="checkbox"><label><input type="checkbox" class="so-reject-form" value="Tax Election" /> Tax Election</label></div>
                    <div class="checkbox"><label><input type="checkbox" class="so-reject-form" value="Bank" /> Bank</label></div>
                </div>
                <div class="form-group">
                    <label>Rejection reason</label>
                    <textarea class="form-control" id="soRejectReason" rows="4" maxlength="1000" placeholder="Explain what needs to be corrected..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="btnConfirmRejectHire">Send Rejection Email</button>
            </div>
        </div>
    </div>
</div>

