<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - Careers</title>
    <link href="~/Content/bootstrap.css" rel="stylesheet" />
    <style>
        body { background: #f4f6f8; font-family: Segoe UI, Arial, sans-serif; }
        .apply-wrap { max-width: 960px; margin: 24px auto; padding: 0 16px; }
        .apply-card { background: #fff; border: 1px solid #dfe3e8; border-radius: 6px; padding: 24px; margin-bottom: 16px; }
        .apply-brand { font-size: 28px; font-weight: 700; color: #1a3a4a; margin: 0 0 8px; }
        .apply-steps { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 16px; }
        .apply-steps span { background: #e8eef2; padding: 4px 10px; border-radius: 4px; font-size: 12px; }
        .apply-steps span.active { background: #2f6f5e; color: #fff; }
        .job-row { border-bottom: 1px solid #eee; padding: 12px 0; }
        .job-row:last-child { border-bottom: none; }
    </style>
    <script src="~/Scripts/jquery-2.2.0.min.js"></script>
</head>
<body>
    <div class="apply-wrap">
        <div class="apply-brand">HRNest Careers</div>
        @RenderBody()
    </div>
    @RenderSection("scripts", required: false)
</body>
</html>
